# ── Build outputs ───────────────────────────────────────────────────────────
dist/
tmp/
out-tsc/
*.tsbuildinfo
.expo/
.expo-shared/

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ── Environment / Secrets ────────────────────────────────────────────────────
# NEVER commit real environment files.
.env
.env.*
!.env.example

# ── Database backups ─────────────────────────────────────────────────────────
# Keep backups/ on disk but never commit them.
# Download them manually via Replit file manager or scp.
backups/
*.dump
*.sql.gz

# ── Drizzle working directory ─────────────────────────────────────────────────
# lib/db/drizzle/ is drizzle-kit's internal scratch dir.
# The canonical migration files live in lib/db/migrations/ (which IS committed).
lib/db/drizzle/

# ── Replit-specific / agent files ────────────────────────────────────────────
.cache/
.local/
.agents/
.replitignore
attached_assets/

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Misc ─────────────────────────────────────────────────────────────────────
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# ── Files kept for Replit compatibility only (excluded from GitHub export) ───
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md
