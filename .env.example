# ============================================================
# Auron Business OS — Environment Variable Reference
# Copy this file to .env and fill in the values.
# Never commit your real .env to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://auron_user:change_me@localhost:5432/auron_os

# ── Session / Auth ───────────────────────────────────────────
# Random secret used to sign session cookies. Use at least 32 random chars.
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-secret

# ── Server ───────────────────────────────────────────────────
# HTTP port for the API server. Nginx will proxy from 443 → this port.
PORT=8080

# ── Node environment ─────────────────────────────────────────
# Set to "production" for deployed instances.
NODE_ENV=production

# ── Frontend base path ───────────────────────────────────────
# Set to "/" when serving from the root of a domain (os.auronevents.com/).
# This is used at FRONTEND BUILD TIME only — not at runtime.
BASE_PATH=/

# ── REMOVED — No longer required ─────────────────────────────
# The following Replit-specific variables are NOT needed outside Replit.
# Do not set them on Hostinger.
#
# REPL_ID        (was: Replit OIDC client ID — replaced by local auth)
# REPLIT_DOMAINS (was: OIDC redirect domains — replaced by local auth)
