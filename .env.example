# ============================================================
# Auron Business OS — Environment Variable Reference
# Copy this file to .env and fill in the values.
# Never commit your real .env to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/auron_os

# ── Session / Auth ───────────────────────────────────────────
# Random secret used to sign session cookies. Use at least 32 random chars.
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-secret

# ── Replit Auth (OIDC) ───────────────────────────────────────
# These are set automatically by Replit in its hosted environment.
# When running OUTSIDE Replit, you must provide an alternative auth strategy.
# See DEPLOYMENT.md §9 for migration guidance.
REPLIT_DOMAINS=your-repl-name.your-user.repl.co
REPL_ID=your-repl-id

# ── API / App URLs ───────────────────────────────────────────
# The public base URL of the deployed application.
# Used by the frontend to reach the API when not on Replit.
APP_URL=https://your-domain.com

# ── Server Port ──────────────────────────────────────────────
# Managed automatically by Replit via the artifact workflow.
# Set explicitly when running outside Replit.
PORT=8080

# ── Optional / Advanced ──────────────────────────────────────
# Node environment. Set to "production" for deployed instances.
NODE_ENV=development

# GST rate default (percentage). Can be overridden per-event in the app.
DEFAULT_GST_RATE=18
